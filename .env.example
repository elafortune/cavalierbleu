# Copier ce fichier en .env.local (développement) et renseigner les mêmes variables dans Vercel (production).

# URL publique du site (utilisée pour les retours de paiement Stripe)
NEXT_PUBLIC_SITE_URL=https://www.cavalierbleu.com

# --- Stripe (https://dashboard.stripe.com/apikeys) ---
# Utiliser d'abord les clés de TEST (sk_test_...), puis les clés live au lancement.
STRIPE_SECRET_KEY=
# Secret du webhook (Dashboard > Développeurs > Webhooks, endpoint : /api/stripe/webhook,
# événement : checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# --- E-mails via Resend (https://resend.com) : formulaire de contact + notification de commande ---
RESEND_API_KEY=
# Destinataire des messages et des notifications de commande
CONTACT_TO=desk@cavalierbleu.com
# Expéditeur (domaine à vérifier dans Resend, ex. "Site Cavalier Bleu <site@cavalierbleu.com>")
CONTACT_FROM=

# --- Espace élève (plateforme membres) ---
# Base Postgres Neon (ajoutée automatiquement par l'intégration Neon de Vercel). Vide en local = base embarquée PGlite (.data/).
DATABASE_URL=
# Secret de session (32+ caractères aléatoires) : openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL publique utilisée par l'authentification (facultatif sur Vercel : déduite automatiquement)
BETTER_AUTH_URL=
# E-mails des administrateurs (Darko…), séparés par des virgules : rôle admin à la création du compte
ADMIN_EMAILS=
# Stockage privé des cours PDF (Vercel Blob). Vide en local = disque (.data/storage).
BLOB_READ_WRITE_TOKEN=
# 1 = le bouton « Se connecter » du site mène au nouvel espace (/connexion) ; sinon à l'ancien espace étudiant
NEXT_PUBLIC_MEMBER_AREA=
# Ancienne variable : URL d'une plateforme externe (inutilisée si NEXT_PUBLIC_MEMBER_AREA=1)
NEXT_PUBLIC_PLATFORM_URL=

# --- Correction par IA (Gemini) : laisser vide pour désactiver ---
GEMINI_API_KEY=
# Nom exact du modèle Gemini à utiliser (voir https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=
